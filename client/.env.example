# Must match ADMIN_LOGIN_PATH in server/.env. The staff sign-in page opens at  /<this value>
# There is no login link anywhere on the public site.
VITE_ADMIN_LOGIN_PATH=ecoplate-staff/admin/login

# Only needed when the API is on a different domain than the site.
# VITE_API_URL=https://api.example.com/api
# VITE_API_ORIGIN=https://api.example.com
