# ---- Server ----
PORT=5000
NODE_ENV=development
# Where the React app runs in development (CORS). Comma separate for several.
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/ecoplate-db

# ---- Security ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Secret URL segment for the staff sign-in page. There is no login button on the site.
# The page lives at  https://your-site/<ADMIN_LOGIN_PATH>
# The same value must be set as VITE_ADMIN_LOGIN_PATH in client/.env
ADMIN_LOGIN_PATH=ecoplate-staff-7f3a9c

# ---- Super admin (created automatically on first start if none exists) ----
SUPERADMIN_NAME=Ecoplate Super Admin
SUPERADMIN_EMAIL=superadmin@ecoplate.rw
SUPERADMIN_PASSWORD=ChangeMe-Now-2026!

# ---- Optional: send donor replies by email from the dashboard ----
# Leave these empty and staff can still reply through their own email app, WhatsApp or SMS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ecoplate <you@example.com>"
